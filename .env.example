# STT provider: "fake" (default, no key needed) or "deepgram"
STT_PROVIDER=fake
# Required only when STT_PROVIDER=deepgram (Member permissions for live token grant)
DEEPGRAM_API_KEY=
# Local dev fallback when grant returns 403 — exposes key to browser WebSocket (dev only)
DEEPGRAM_ALLOW_BROWSER_LIVE=false
# Mobile mic access requires HTTPS — use `npm run dev:https` when testing on a phone
