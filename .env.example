# STT provider: "fake" (default, no key needed) or "deepgram"
STT_PROVIDER=fake
# Required only when STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
# Local-dev only: if /v1/auth/grant fails (key is not Member+), hand the API key
# to the browser WebSocket so live transcription still works on localhost.
DEEPGRAM_ALLOW_BROWSER_LIVE=

# Field extraction: "fake" (default, no key needed) or "claude"
EXTRACT_PROVIDER=fake
# Required only when EXTRACT_PROVIDER=claude
ANTHROPIC_API_KEY=
